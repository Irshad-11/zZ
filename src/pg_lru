
#include <stdio.h>

int main() {
    int frame[20], page[50], last[20];
    int n, m, i, j;
    int fault = 0, hit = 0, flag;
    int pos, least;

    printf("Enter Number of Frames: ");
    scanf("%d", &n);

    printf("Enter Number of Pages: ");
    scanf("%d", &m);

    for(i = 0; i < n; i++) {
        frame[i] = -1;
        last[i] = -1;
    }

    printf("Enter Page Reference String: ");
    for(i = 0; i < m; i++) {
        scanf("%d", &page[i]);
    }

    for(i = 0; i < m; i++) {
        flag = 0;

        for(j = 0; j < n; j++) {
            if(frame[j] == page[i]) {
                hit++;
                flag = 1;
                last[j] = i;
                break;
            }
        }

        if(flag == 0) {
            fault++;
            pos = -1;

            for(j = 0; j < n; j++) {
                if(frame[j] == -1) {
                    pos = j;
                    break;
                }
            }

            if(pos == -1) {
                least = 9999;

                for(j = 0; j < n; j++) {
                    if(last[j] < least) {
                        least = last[j];
                        pos = j;
                    }
                }
            }

            frame[pos] = page[i];
            last[pos] = i;
        }
    }

    printf("Page Fault = %d\n", fault);
    printf("Page Hit = %d\n", hit);

    return 0;
}

